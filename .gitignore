# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# scratch / artefacts locaux
/.tmp
/tmp/

# Export Teachizy (PDF + session navigateur — ne jamais committer)
/.teachizy-auth/
/teachizy-export/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# Code d’installation Elfsight (UUID widget — secret d’affichage, pas versionné)
/config/elfsight-google-reviews.embed

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dates git pour sitemap (généré au build)
lib/sitemap-dates.generated.json

# état IndexNow (dernier commit soumis — local / CI)
.indexnow-state.json
