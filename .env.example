# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ton_anon_key
# Clé service role (serveur uniquement — invitations, CV candidatures, création comptes)
SUPABASE_SERVICE_ROLE_KEY=ton_service_role_key

# Migration SQL directe (optionnel — scripts/apply-*-migration.mjs)
# DATABASE_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=mot_de_passe_db

# URL publique du site (liens d’invitation)
NEXT_PUBLIC_SITE_URL=https://www.laureolivie.fr

# Resend — invitations, contact, candidatures carrière
RESEND_API_KEY=re_xxxxxxxx
# Expéditeur vérifié chez Resend (ex. Formations Laure Olivié <onboarding@resend.dev>)
EMAIL_FROM="OFC Création d'Entreprise <formations@votredomaine.fr>"
# Alias optionnel (si EMAIL_FROM absent)
# INVITATION_FROM_EMAIL=formations@votredomaine.fr

# Calendly (URL de réservation Laure — défaut dans lib/calendly.ts si vide)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/votre-compte/votre-evenement

# Google Analytics 4 — requis pour l’événement rdv_calendly_click (optionnel)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Places API — repli carrousel /avis-clients (serveur uniquement, facturation Google Cloud)
# GOOGLE_PLACE_ID=ChIJ...
# GOOGLE_PLACES_API_KEY=AIza...
# Ne jamais préfixer NEXT_PUBLIC_ (clé privée).
# Diagnostic : node --env-file=.env.local scripts/test-google-reviews-api.mjs
# Console Google Cloud : activer « Places API (New) », facturation activée, clé autorisée sur cette API.

# Elfsight — widget Google Reviews (/avis-clients, après consentement cookies)
# Option A — UUID seul :
# NEXT_PUBLIC_ELFSIGHT_GOOGLE_REVIEWS_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Option B — coller le code d’installation Elfsight entier :
# NEXT_PUBLIC_ELFSIGHT_GOOGLE_REVIEWS_EMBED="<script...><div class=\"elfsight-app-...\">"
# Option C — fichier config/elfsight-google-reviews.embed (voir .example)

# Liste blanche emails pour rôle admin (/admin). Séparer par des virgules.
ADMIN_ALLOWED_EMAILS=contact@laureolivie.fr

# Secret Bearer pour /api/cron/* (obligatoire en production)
CRON_SECRET=remplace_par_un_secret_long_aleatoire

# Stripe (optionnel — paiements LMS)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# OpenAI (chat RAG / indexation)
# OPENAI_API_KEY=sk-...
