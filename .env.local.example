# Avis Google — widget Trustindex GRATUIT (recommandé)
# Compte : https://www.trustindex.io/ → Connecter Google → Widget → copier l’ID du loader.js?...
# NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID="xxxxxxxx"

# Google Places API — optionnel / nécessite facturation Google Cloud (éviter si vous ne voulez pas payer)
# GOOGLE_PLACE_ID="ChIJ..."
# GOOGLE_PLACES_API_KEY="AIza..."

# URL Calendly (prise de RDV). Si non défini, valeur par défaut dans lib/calendly.ts
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/..."

# Autres variables d'environnement...
