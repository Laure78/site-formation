# Google Places API — optionnel (nécessite facturation Google Cloud)
# GOOGLE_PLACE_ID="ChIJ..."
# GOOGLE_PLACES_API_KEY="AIza..."

# URL Calendly (prise de RDV). Si non défini, valeur par défaut dans lib/calendly.ts
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/..."

# Widget Elfsight Google Reviews (/avis-clients) — dashboard Elfsight → Install
# NEXT_PUBLIC_ELFSIGHT_GOOGLE_REVIEWS_APP_ID=
# ou dupliquer config/elfsight-google-reviews.embed.example → config/elfsight-google-reviews.embed

# Places API (carrousel repli) — à configurer aussi sur Railway en prod
# GOOGLE_PLACE_ID=
# GOOGLE_PLACES_API_KEY=

# Autres variables d'environnement...
